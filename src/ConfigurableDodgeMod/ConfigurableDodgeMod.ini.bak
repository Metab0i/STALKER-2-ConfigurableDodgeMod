; Configurable Dodge Mod - configuration
;
; Edit values below and save - changes apply within ~2 seconds while the
; game is running (no restart needed). Run Setup.bat for an interactive
; setup instead, if you prefer being prompted.
;
; Only ONE modality can be active: "button" or "doubletap".

[Config]
; "button"    = hold a movement key, press the dodge button
; "doubletap" = double-tap the dodge keys
Modality=button

; --- Button modality ---
; The dodge button. Hold a movement key (W/A/S/D or your bindings) and
; press this button to dodge in that direction. Standing still or moving
; straight forward does nothing.
; Values are Virtual-Key codes in hex (they map 1:1 to Windows VKs):
;   0x58=X  0x5A=Z  0x43=C  0x53=S  0x51=Q  0x51... letters 0x41-0x5A
;   0x01=LeftMouse  0x02=RightMouse  0x04=MiddleMouse
;   0x05=Mouse4     0x06=Mouse5      0x20=Space  0x14=CapsLock
;   F-keys: 0x70=F1 ... 0x7B=F12   arrows: 0x25-0x28
; MODIFIER KEYS (0xA0-0xA5, 0x10-0x12: Alt/Ctrl/Shift) CANNOT be dodge
; buttons - the engine hook never sees them. The mod rejects them at load.
; Key name reference: https://ue4ss.org/data-complex/coding-standard#a-name-usage
; Common values: Left Alt is NOT supported (engine modifiers cannot be
; bound) - use e.g. Space, X, Q, R, CapsLock, ThumbMouseButton (Mouse 4),
; ThumbMouseButton2 (Mouse 5), LeftMouseButton, RightMouseButton
ButtonKey=0x58

; --- Double-tap modality ---
; Double-tap these keys to dodge left / right / back
DoubleTapLeft=Z
DoubleTapRight=C
DoubleTapBack=S

; --- Forces (cm/s) and stamina cost (vanilla jump = 20) ---
SideHorizontal=650
SideVertical=500
BackHorizontal=900
BackVertical=200
StaminaCost=20
